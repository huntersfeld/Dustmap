{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "owner": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "dm": {
          ".write": "auth != null && root.child('rooms').child($room).child('owner').val() === auth.uid"
        },
        "d": {
          ".write": "auth != null && (root.child('rooms').child($room).child('owner').val() === auth.uid || root.child('rooms').child($room).child('dm').val() === auth.uid)"
        },
        "people": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 40"
          }
        },
        "presence": {
          "$tab": {
            ".write": "auth != null && $tab.beginsWith(auth.uid + '_')",
            ".validate": "!newData.exists() || (newData.child('by').val() === auth.uid && newData.child('p').isString() && newData.child('p').val().length <= 4096)"
          }
        }
      }
    }
  }
}
